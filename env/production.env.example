# Deployment settings only. Carrier credentials and enable switches are saved in the web UI.
# The default area quotes production; /sandbox quotes sandbox / UAT.
# APP_ENV controls HTTP/cookie policy, not carrier mode.
# Set APP_ORIGIN to your real HTTPS origin before hosted deployment.
APP_ENV=production
APP_ORIGIN=
PORT=3000
DATABASE_PROVIDER=postgresql
DATABASE_URL=
POSTGRES_PASSWORD=
MOCK_CARRIERS=false
CARRIER_TIMEOUT_MS=12000
USER_EMAIL=
USER_PASSWORD=
CREATE_USER_ROLE=operator
